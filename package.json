{
  "name": "desktop-portal",
  "version": "1.0.0",
  "description": "DreamBuilder unified login portal built with Next.js 14",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:guancyxx/desktop_portal.git"
  },
  "keywords": [
    "nextjs",
    "portal",
    "keycloak",
    "sso",
    "authentication",
    "dreambuilder",
    "ark-desktop"
  ],
  "author": "DreamBuilder Team",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
